# Copia questo file in ".env" e completa i valori.

PORT=3000

# Account del proprietario ("VIP"): viene creato al primo avvio con questa password.
OWNER_EMAIL=bryansalguero26@icloud.com
OWNER_PASSWORD=
OWNER_NAME=Bryan

# Assistente AI gratuito con Google Gemini: crea la chiave su https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Facoltativo: modello Gemini da usare (di default il "Flash" più recente disponibile)
GEMINI_MODEL=
# In alternativa (a pagamento) Claude di Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Richieste AI massime per utente nelle ultime 24 ore (il proprietario non ha limiti)
AI_DAILY_LIMIT=100

# Sincronizzazione con Google Drive (vedi README → "Google Drive")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Codice di accesso permanente al Drive: lo trovi nell'area riservata dopo aver collegato il Drive.
# Serve sui server gratuiti (senza disco) per ricollegarsi e ripristinare il database dopo ogni riavvio.
DRIVE_REFRESH_TOKEN=
# Indirizzo pubblico del sito, es. https://appunti-del-senato.onrender.com (serve per il collegamento a Google)
PUBLIC_URL=
# Ogni quanti minuti controllare il Drive
DRIVE_SYNC_MINUTES=5
# I file del Drive più grandi di così non vengono importati (MB)
DRIVE_MAX_FILE_MB=100

# Dimensione massima di ogni file caricato (MB)
MAX_UPLOAD_MB=50
SESSION_DAYS=30

# In produzione dietro HTTPS / reverse proxy
COOKIE_SECURE=false
TRUST_PROXY=false
